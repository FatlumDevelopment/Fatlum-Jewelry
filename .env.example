# Public. Catalog reads and inquiry inserts go through these and Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Optional aliases, same values as above. The gold site uses these names.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional. The storefront does not use it, so anonymous inserts stay bound by RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When unset, a request is only stored in Supabase and no email is sent.
RESEND_API_KEY=

# Used only when RESEND_API_KEY is set. The from-address must be a verified Resend domain.
MAIL_FROM=Fatlum Jewelry <anfragen@fatlum.jewelry>
MAIL_TO=info@fatlum.jewelry
